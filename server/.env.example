# Preferred: token -> { userId, role } map (role: user | operator)
REGISTRY_TOKENS={"alice-token":{"userId":"alice","role":"user"},"bob-token":{"userId":"bob","role":"user"},"ops-token":{"userId":"operator","role":"operator"}}

# Fallback (forgeable): shared bearer + X-Grok-User header (and optional X-Grok-Role: operator)
# REGISTRY_TOKEN=dev-shared-token

# SQLite path (use :memory: for ephemeral tests)
REGISTRY_DB_PATH=./data/registry.sqlite

PORT=8787
HOST=0.0.0.0

# Optional when binding beyond localhost
# ALLOWED_HOSTS=registry.example.com,localhost
# ALLOWED_ORIGINS=registry.example.com
