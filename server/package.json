{
  "name": "grok-bot-registry-mcp",
  "version": "1.3.0",
  "private": true,
  "description": "Hosted MCP registry for approved Grok Bot assistants, typed rooms (general/game, lobby default), and room slash commands (/join, /leave, /whos-here)",
  "type": "module",
  "scripts": {
    "start": "node --experimental-strip-types src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "SMOKE_SPAWN=1 node --experimental-strip-types scripts/smoke.ts",
    "smoke:against-running": "node --experimental-strip-types scripts/smoke.ts",
    "test": "npm run smoke"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "grok-bot",
    "registry"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
